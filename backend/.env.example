# AgriSense Environment Configuration Template
# Copy this file to .env and fill in appropriate values

PORT=5000

# Browser frontend origin(s), comma-separated when more than one is needed.
# The API uses Authorization: Bearer JWT, so browser credentials are disabled.
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB URI (MongoDB Atlas SRV or local instance)
# Local: mongodb://localhost:27017/agrisense
MONGODB_URI=mongodb+srv://AgriSense:<MONGODB_PASSWORD>@agrisense.e4pyxxk.mongodb.net/agrisense?retryWrites=true&w=majority&appName=AgriSense

# Python AI Engine settings
PYTHON_PATH=python
AI_SERVER_URL=http://127.0.0.1:5001
AI_TIMEOUT_MS=30000

# JWT signing secret (generate a random value of at least 32 bytes; keep it in .env only)
JWT_SECRET=<replace_with_random_32_byte_or_longer_secret>

# Government Market Data API (Optional for live Mandi prices)
DATA_GOV_IN_API_KEY=<your_api_key>
